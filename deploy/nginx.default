
# nginx.default

server {
    listen 8000;
    server_name zirkusmond.de;

    # Django admin
    location /mondmin/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 4600;
        proxy_connect_timeout 600;
    }

    # API requests to Django backend
    location /api/ {
        proxy_pass http://127.0.0.1:8010/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 4600;
        proxy_connect_timeout 600;
    }

    # Serve static files from Django
    location /static/ {
        root /srv/data/;
    }

    # Serve media files
    location /media/ {
        root /srv/data/;
    }

    # Proxy everything else to TanStack Start SSR server
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 4600;
        proxy_connect_timeout 600;
    }

    client_max_body_size 10M;
}

# Listmonk newsletter management
server {
    listen 8000;
    server_name news.zirkusmond.de;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 10M;
}
